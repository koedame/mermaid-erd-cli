{
  "name": "mermaid-erd-cli",
  "version": "0.1.0",
  "description": "Generate a Mermaid ER diagram from a live database (PostgreSQL/MySQL/SQLite) or a schema dump. Outputs an interactive HTML viewer or raw Mermaid/JSON to stdout. No ORM or framework required.",
  "type": "module",
  "bin": {
    "mermaid-erd-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "e2e": "node --import tsx scripts/e2e.ts",
    "lint": "biome check src test scripts",
    "format": "biome check --write src test scripts",
    "prepack": "npm run build"
  },
  "keywords": [
    "mermaid",
    "erd",
    "er-diagram",
    "database",
    "schema",
    "postgresql",
    "mysql",
    "sqlite",
    "diagram",
    "cli"
  ],
  "license": "MIT",
  "author": "koedame",
  "homepage": "https://github.com/koedame/mermaid-erd-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koedame/mermaid-erd-cli.git"
  },
  "bugs": {
    "url": "https://github.com/koedame/mermaid-erd-cli/issues"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.11.0",
    "better-sqlite3": "^11.3.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "playwright": "^1.47.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
